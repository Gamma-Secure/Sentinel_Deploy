{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "14499703184678286414"
    }
  },
  "parameters": {
    "location": {
      "type": "string"
    },
    "resourceGroupName": {
      "type": "string"
    },
    "workspaceName": {
      "type": "string"
    },
    "enableEntraSignInLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "enableEntraAuditLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "enableEntraRiskLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "enableEntraGraphLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "enableActivityPolicy": {
      "type": "bool",
      "defaultValue": false
    },
    "managementGroupId": {
      "type": "string",
      "defaultValue": ""
    },
    "enableKeyVaultLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "enableNsgLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "enableFirewallLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "enableAppGatewayLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "enableAksLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "enableAppServiceLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "remediateExistingResources": {
      "type": "bool",
      "defaultValue": true
    }
  },
  "variables": {
    "entraSignIn": "[if(parameters('enableEntraSignInLogs'), createArray('SignInLogs', 'NonInteractiveUserSignInLogs', 'ServicePrincipalSignInLogs', 'ManagedIdentitySignInLogs'), createArray())]",
    "entraAudit": "[if(parameters('enableEntraAuditLogs'), createArray('AuditLogs', 'ProvisioningLogs'), createArray())]",
    "entraRisk": "[if(parameters('enableEntraRiskLogs'), createArray('RiskyUsers', 'UserRiskEvents', 'RiskyServicePrincipals', 'ServicePrincipalRiskEvents'), createArray())]",
    "entraGraph": "[if(parameters('enableEntraGraphLogs'), createArray('MicrosoftGraphActivityLogs'), createArray())]",
    "entraCategories": "[concat(variables('entraSignIn'), variables('entraAudit'), variables('entraRisk'), variables('entraGraph'))]",
    "resourceLogSources": "[concat(if(parameters('enableKeyVaultLogs'), createArray(createObject('key', 'keyvault', 'label', 'Key Vault', 'resourceType', 'Microsoft.KeyVault/vaults')), createArray()), if(parameters('enableNsgLogs'), createArray(createObject('key', 'nsg', 'label', 'Network Security Group', 'resourceType', 'Microsoft.Network/networkSecurityGroups')), createArray()), if(parameters('enableFirewallLogs'), createArray(createObject('key', 'firewall', 'label', 'Azure Firewall', 'resourceType', 'Microsoft.Network/azureFirewalls')), createArray()), if(parameters('enableAppGatewayLogs'), createArray(createObject('key', 'appgw', 'label', 'Application Gateway / WAF', 'resourceType', 'Microsoft.Network/applicationGateways')), createArray()), if(parameters('enableAksLogs'), createArray(createObject('key', 'aks', 'label', 'AKS', 'resourceType', 'Microsoft.ContainerService/managedClusters')), createArray()), if(parameters('enableAppServiceLogs'), createArray(createObject('key', 'appservice', 'label', 'App Service', 'resourceType', 'Microsoft.Web/sites')), createArray()))]"
  },
  "resources": [
    {
      "condition": "[or(or(not(empty(variables('entraCategories'))), parameters('enableActivityPolicy')), not(empty(variables('resourceLogSources'))))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "sentinel-tenant-scope",
      "scope": "/",
      "location": "[deployment().location]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "workspaceId": {
            "value": "[resourceId(subscription().subscriptionId, parameters('resourceGroupName'), 'Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"
          },
          "subscriptionId": {
            "value": "[subscription().subscriptionId]"
          },
          "resourceGroupName": {
            "value": "[parameters('resourceGroupName')]"
          },
          "entraCategories": {
            "value": "[variables('entraCategories')]"
          },
          "enableActivityPolicy": {
            "value": "[parameters('enableActivityPolicy')]"
          },
          "managementGroupId": {
            "value": "[parameters('managementGroupId')]"
          },
          "resourceLogSources": {
            "value": "[variables('resourceLogSources')]"
          },
          "remediateExisting": {
            "value": "[parameters('remediateExistingResources')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-08-01/tenantDeploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.47.16.16243",
              "templateHash": "3645388532671653953"
            }
          },
          "parameters": {
            "location": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "subscriptionId": {
              "type": "string"
            },
            "resourceGroupName": {
              "type": "string"
            },
            "entraCategories": {
              "type": "array"
            },
            "enableActivityPolicy": {
              "type": "bool"
            },
            "managementGroupId": {
              "type": "string"
            },
            "resourceLogSources": {
              "type": "array"
            },
            "remediateExisting": {
              "type": "bool"
            }
          },
          "resources": [
            {
              "condition": "[not(empty(parameters('entraCategories')))]",
              "type": "microsoft.aadiam/diagnosticSettings",
              "apiVersion": "2017-04-01",
              "name": "sentinel-entra-logs",
              "properties": {
                "copy": [
                  {
                    "name": "logs",
                    "count": "[length(parameters('entraCategories'))]",
                    "input": {
                      "category": "[parameters('entraCategories')[copyIndex('logs')]]",
                      "enabled": true
                    }
                  }
                ],
                "workspaceId": "[parameters('workspaceId')]"
              }
            },
            {
              "condition": "[parameters('enableActivityPolicy')]",
              "type": "Microsoft.Resources/deployments",
              "apiVersion": "2025-04-01",
              "name": "sentinel-activity-policy",
              "scope": "[format('Microsoft.Management/managementGroups/{0}', parameters('managementGroupId'))]",
              "location": "[deployment().location]",
              "properties": {
                "expressionEvaluationOptions": {
                  "scope": "inner"
                },
                "mode": "Incremental",
                "parameters": {
                  "location": {
                    "value": "[parameters('location')]"
                  },
                  "workspaceId": {
                    "value": "[parameters('workspaceId')]"
                  }
                },
                "template": {
                  "$schema": "https://schema.management.azure.com/schemas/2019-08-01/managementGroupDeploymentTemplate.json#",
                  "contentVersion": "1.0.0.0",
                  "metadata": {
                    "_generator": {
                      "name": "bicep",
                      "version": "0.47.16.16243",
                      "templateHash": "8665663601427448690"
                    }
                  },
                  "parameters": {
                    "location": {
                      "type": "string"
                    },
                    "workspaceId": {
                      "type": "string"
                    }
                  },
                  "variables": {
                    "settingName": "setByPolicy-SentinelActivity",
                    "monitoringContributor": "749f88d5-cbae-40b8-bcfc-e573ddc772fa",
                    "activityCategories": [
                      "Administrative",
                      "Security",
                      "ServiceHealth",
                      "Alert",
                      "Recommendation",
                      "Policy",
                      "Autoscale",
                      "ResourceHealth"
                    ]
                  },
                  "resources": [
                    {
                      "type": "Microsoft.Authorization/policyDefinitions",
                      "apiVersion": "2023-04-01",
                      "name": "gammasecure-activity-logs",
                      "properties": {
                        "displayName":"Gamma Secure - Subscription Activity Log Policy",
                        "policyType": "Custom",
                        "mode": "All",
                        "parameters": {
                          "logAnalytics": {
                            "type": "String",
                            "metadata": {
                              "displayName": "Log Analytics workspace resource ID"
                            }
                          }
                        },
                        "policyRule": {
                          "if": {
                            "field": "type",
                            "equals": "Microsoft.Resources/subscriptions"
                          },
                          "then": {
                            "effect": "deployIfNotExists",
                            "details": {
                              "type": "Microsoft.Insights/diagnosticSettings",
                              "name": "[variables('settingName')]",
                              "deploymentScope": "subscription",
                              "existenceScope": "subscription",
                              "existenceCondition": {
                                "field": "Microsoft.Insights/diagnosticSettings/workspaceId",
                                "equals": "[[parameters('logAnalytics')]"
                              },
                              "roleDefinitionIds": [
                                "[format('/providers/Microsoft.Authorization/roleDefinitions/{0}', variables('monitoringContributor'))]"
                              ],
                              "deployment": {
                                "location": "[parameters('location')]",
                                "properties": {
                                  "mode": "incremental",
                                  "template": {
                                    "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
                                    "contentVersion": "1.0.0.0",
                                    "parameters": {
                                      "logAnalytics": {
                                        "type": "string"
                                      }
                                    },
                                    "resources": [
                                      {
                                        "type": "Microsoft.Insights/diagnosticSettings",
                                        "apiVersion": "2021-05-01-preview",
                                        "name": "[variables('settingName')]",
                                        "properties": {
                                          "copy": [
                                            {
                                              "name": "logs",
                                              "count": "[length(variables('activityCategories'))]",
                                              "input": {
                                                "category": "[variables('activityCategories')[copyIndex('logs')]]",
                                                "enabled": true
                                              }
                                            }
                                          ],
                                          "workspaceId": "[[parameters('logAnalytics')]"
                                        }
                                      }
                                    ]
                                  },
                                  "parameters": {
                                    "logAnalytics": {
                                      "value": "[[parameters('logAnalytics')]"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "Microsoft.Authorization/policyAssignments",
                      "apiVersion": "2024-04-01",
                      "name": "gammasecure-activity-logs",
                      "location": "[parameters('location')]",
                      "identity": {
                        "type": "SystemAssigned"
                      },
                      "properties": {
                        "displayName": "Gamma Secure - Subscription Activity Logs to Sentinel",
                        "policyDefinitionId": "[extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyDefinitions', 'gammasecure-activity-logs')]",
                        "parameters": {
                          "logAnalytics": {
                            "value": "[parameters('workspaceId')]"
                          }
                        }
                      },
                      "dependsOn": [
                        "[extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyDefinitions', 'gammasecure-activity-logs')]"
                      ]
                    },
                    {
                      "type": "Microsoft.Authorization/roleAssignments",
                      "apiVersion": "2022-04-01",
                      "name": "[guid(managementGroup().id, 'gammasecure-activity-logs', variables('monitoringContributor'))]",
                      "properties": {
                        "roleDefinitionId": "[tenantResourceId('Microsoft.Authorization/roleDefinitions', variables('monitoringContributor'))]",
                        "principalId": "[reference(extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', 'gammasecure-activity-logs'), '2024-04-01', 'full').identity.principalId]",
                        "principalType": "ServicePrincipal"
                      },
                      "dependsOn": [
                        "[extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', 'gammasecure-activity-logs')]"
                      ]
                    }
                  ],
                  "outputs": {
                    "principalId": {
                      "type": "string",
                      "value": "[reference(extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', 'gammasecure-activity-logs'), '2024-04-01', 'full').identity.principalId]"
                    },
                    "assignmentName": {
                      "type": "string",
                      "value": "gammasecure-activity-logs"
                    }
                  }
                }
              }
            },
            {
              "condition": "[parameters('enableActivityPolicy')]",
              "type": "Microsoft.Resources/deployments",
              "apiVersion": "2025-04-01",
              "name": "sentinel-activity-policy-workspace-role",
              "subscriptionId": "[parameters('subscriptionId')]",
              "resourceGroup": "[parameters('resourceGroupName')]",
              "properties": {
                "expressionEvaluationOptions": {
                  "scope": "inner"
                },
                "mode": "Incremental",
                "parameters": {
                  "principalId": {
                    "value": "[reference(extensionResourceId(tenantResourceId('Microsoft.Management/managementGroups', parameters('managementGroupId')), 'Microsoft.Resources/deployments', 'sentinel-activity-policy'), '2025-04-01').outputs.principalId.value]"
                  }
                },
                "template": {
                  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
                  "contentVersion": "1.0.0.0",
                  "metadata": {
                    "_generator": {
                      "name": "bicep",
                      "version": "0.47.16.16243",
                      "templateHash": "10979228128526893092"
                    }
                  },
                  "parameters": {
                    "principalId": {
                      "type": "string"
                    }
                  },
                  "variables": {
                    "logAnalyticsContributor": "92aaf0da-9dab-42b6-94a3-d43ce8d16293"
                  },
                  "resources": [
                    {
                      "type": "Microsoft.Authorization/roleAssignments",
                      "apiVersion": "2022-04-01",
                      "name": "[guid(resourceGroup().id, parameters('principalId'), variables('logAnalyticsContributor'))]",
                      "properties": {
                        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('logAnalyticsContributor'))]",
                        "principalId": "[parameters('principalId')]",
                        "principalType": "ServicePrincipal"
                      }
                    }
                  ]
                }
              },
              "dependsOn": [
                "[extensionResourceId(tenantResourceId('Microsoft.Management/managementGroups', parameters('managementGroupId')), 'Microsoft.Resources/deployments', 'sentinel-activity-policy')]"
              ]
            },
            {
              "condition": "[not(empty(parameters('resourceLogSources')))]",
              "type": "Microsoft.Resources/deployments",
              "apiVersion": "2025-04-01",
              "name": "sentinel-resource-diagnostics-mg",
              "scope": "[format('Microsoft.Management/managementGroups/{0}', parameters('managementGroupId'))]",
              "location": "[deployment().location]",
              "properties": {
                "expressionEvaluationOptions": {
                  "scope": "inner"
                },
                "mode": "Incremental",
                "parameters": {
                  "location": {
                    "value": "[parameters('location')]"
                  },
                  "workspaceId": {
                    "value": "[parameters('workspaceId')]"
                  },
                  "workspaceSubscriptionId": {
                    "value": "[parameters('subscriptionId')]"
                  },
                  "workspaceResourceGroup": {
                    "value": "[parameters('resourceGroupName')]"
                  },
                  "sources": {
                    "value": "[parameters('resourceLogSources')]"
                  },
                  "remediateExisting": {
                    "value": "[parameters('remediateExisting')]"
                  }
                },
                "template": {
                  "$schema": "https://schema.management.azure.com/schemas/2019-08-01/managementGroupDeploymentTemplate.json#",
                  "contentVersion": "1.0.0.0",
                  "metadata": {
                    "_generator": {
                      "name": "bicep",
                      "version": "0.47.16.16243",
                      "templateHash": "15612686809304490384"
                    }
                  },
                  "parameters": {
                    "location": {
                      "type": "string"
                    },
                    "workspaceId": {
                      "type": "string"
                    },
                    "workspaceSubscriptionId": {
                      "type": "string"
                    },
                    "workspaceResourceGroup": {
                      "type": "string"
                    },
                    "sources": {
                      "type": "array",
                      "metadata": {
                        "description": "Array of { key, label, resourceType }"
                      }
                    },
                    "remediateExisting": {
                      "type": "bool",
                      "defaultValue": true,
                      "metadata": {
                        "description": "Create remediation tasks (re-evaluates compliance first) so existing resources are fixed now"
                      }
                    }
                  },
                  "variables": {
                    "monitoringContributor": "749f88d5-cbae-40b8-bcfc-e573ddc772fa",
                    "logAnalyticsContributor": "92aaf0da-9dab-42b6-94a3-d43ce8d16293",
                    "settingName": "setByPolicy-Sentinel"
                  },
                  "resources": [
                    {
                      "copy": {
                        "name": "defs",
                        "count": "[length(parameters('sources'))]"
                      },
                      "type": "Microsoft.Authorization/policyDefinitions",
                      "apiVersion": "2023-04-01",
                      "name": "[format('sentinel-diag-{0}', parameters('sources')[copyIndex()].key)]",
                      "properties": {
                        "displayName": "[format('Sentinel: send {0} resource logs to Log Analytics', parameters('sources')[copyIndex()].label)]",
                        "policyType": "Custom",
                        "mode": "Indexed",
                        "parameters": {
                          "logAnalytics": {
                            "type": "String",
                            "metadata": {
                              "displayName": "Log Analytics workspace resource ID"
                            }
                          }
                        },
                        "policyRule": {
                          "if": {
                            "field": "type",
                            "equals": "[parameters('sources')[copyIndex()].resourceType]"
                          },
                          "then": {
                            "effect": "deployIfNotExists",
                            "details": {
                              "type": "Microsoft.Insights/diagnosticSettings",
                              "name": "[variables('settingName')]",
                              "existenceCondition": {
                                "allOf": [
                                  {
                                    "field": "Microsoft.Insights/diagnosticSettings/workspaceId",
                                    "equals": "[[parameters('logAnalytics')]"
                                  }
                                ]
                              },
                              "roleDefinitionIds": [
                                "[format('/providers/Microsoft.Authorization/roleDefinitions/{0}', variables('monitoringContributor'))]",
                                "[format('/providers/Microsoft.Authorization/roleDefinitions/{0}', variables('logAnalyticsContributor'))]"
                              ],
                              "deployment": {
                                "properties": {
                                  "mode": "incremental",
                                  "template": {
                                    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
                                    "contentVersion": "1.0.0.0",
                                    "parameters": {
                                      "resourceName": {
                                        "type": "string"
                                      },
                                      "location": {
                                        "type": "string"
                                      },
                                      "logAnalytics": {
                                        "type": "string"
                                      }
                                    },
                                    "resources": [
                                      {
                                        "type": "[format('{0}/providers/diagnosticSettings', parameters('sources')[copyIndex()].resourceType)]",
                                        "apiVersion": "2021-05-01-preview",
                                        "name": "[format('[concat(parameters(''resourceName''), ''/Microsoft.Insights/{0}'')]', variables('settingName'))]",
                                        "location": "[[parameters('location')]",
                                        "properties": {
                                          "workspaceId": "[[parameters('logAnalytics')]",
                                          "logs": [
                                            {
                                              "categoryGroup": "allLogs",
                                              "enabled": true
                                            }
                                          ]
                                        }
                                      }
                                    ]
                                  },
                                  "parameters": {
                                    "resourceName": {
                                      "value": "[[field('name')]"
                                    },
                                    "location": {
                                      "value": "[[field('location')]"
                                    },
                                    "logAnalytics": {
                                      "value": "[[parameters('logAnalytics')]"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    {
                      "copy": {
                        "name": "assigns",
                        "count": "[length(parameters('sources'))]"
                      },
                      "type": "Microsoft.Authorization/policyAssignments",
                      "apiVersion": "2024-04-01",
                      "name": "[format('sentinel-diag-{0}', parameters('sources')[copyIndex()].key)]",
                      "location": "[parameters('location')]",
                      "identity": {
                        "type": "SystemAssigned"
                      },
                      "properties": {
                        "displayName": "[format('Sentinel: {0} logs to Log Analytics', parameters('sources')[copyIndex()].label)]",
                        "policyDefinitionId": "[extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyDefinitions', format('sentinel-diag-{0}', parameters('sources')[copyIndex()].key))]",
                        "parameters": {
                          "logAnalytics": {
                            "value": "[parameters('workspaceId')]"
                          }
                        }
                      },
                      "dependsOn": [
                        "[extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyDefinitions', format('sentinel-diag-{0}', parameters('sources')[copyIndex()].key))]"
                      ]
                    },
                    {
                      "copy": {
                        "name": "monitoringRoles",
                        "count": "[length(parameters('sources'))]"
                      },
                      "type": "Microsoft.Authorization/roleAssignments",
                      "apiVersion": "2022-04-01",
                      "name": "[guid(managementGroup().id, parameters('sources')[copyIndex()].key, variables('monitoringContributor'))]",
                      "properties": {
                        "roleDefinitionId": "[tenantResourceId('Microsoft.Authorization/roleDefinitions', variables('monitoringContributor'))]",
                        "principalId": "[reference(extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', format('sentinel-diag-{0}', parameters('sources')[copyIndex()].key)), '2024-04-01', 'full').identity.principalId]",
                        "principalType": "ServicePrincipal"
                      },
                      "dependsOn": [
                        "[extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', format('sentinel-diag-{0}', parameters('sources')[copyIndex()].key))]"
                      ]
                    },
                    {
                      "copy": {
                        "name": "remediations",
                        "count": "[length(parameters('sources'))]"
                      },
                      "condition": "[parameters('remediateExisting')]",
                      "type": "Microsoft.PolicyInsights/remediations",
                      "apiVersion": "2021-10-01",
                      "name": "[format('fix-{0}', parameters('sources')[copyIndex()].key)]",
                      "properties": {
                        "policyAssignmentId": "[extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', format('sentinel-diag-{0}', parameters('sources')[copyIndex()].key))]",
                        "resourceDiscoveryMode": "ReEvaluateCompliance"
                      },
                      "dependsOn": [
                        "[extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', format('sentinel-diag-{0}', parameters('sources')[copyIndex()].key))]",
                        "monitoringRoles",
                        "workspaceRoles"
                      ]
                    },
                    {
                      "copy": {
                        "name": "workspaceRoles",
                        "count": "[length(parameters('sources'))]"
                      },
                      "type": "Microsoft.Resources/deployments",
                      "apiVersion": "2025-04-01",
                      "name": "[format('wsrole-{0}-{1}', parameters('sources')[copyIndex()].key, uniqueString(managementGroup().id))]",
                      "subscriptionId": "[parameters('workspaceSubscriptionId')]",
                      "resourceGroup": "[parameters('workspaceResourceGroup')]",
                      "properties": {
                        "expressionEvaluationOptions": {
                          "scope": "inner"
                        },
                        "mode": "Incremental",
                        "parameters": {
                          "principalId": {
                            "value": "[reference(extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', format('sentinel-diag-{0}', parameters('sources')[copyIndex()].key)), '2024-04-01', 'full').identity.principalId]"
                          }
                        },
                        "template": {
                          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
                          "contentVersion": "1.0.0.0",
                          "metadata": {
                            "_generator": {
                              "name": "bicep",
                              "version": "0.47.16.16243",
                              "templateHash": "10979228128526893092"
                            }
                          },
                          "parameters": {
                            "principalId": {
                              "type": "string"
                            }
                          },
                          "variables": {
                            "logAnalyticsContributor": "92aaf0da-9dab-42b6-94a3-d43ce8d16293"
                          },
                          "resources": [
                            {
                              "type": "Microsoft.Authorization/roleAssignments",
                              "apiVersion": "2022-04-01",
                              "name": "[guid(resourceGroup().id, parameters('principalId'), variables('logAnalyticsContributor'))]",
                              "properties": {
                                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('logAnalyticsContributor'))]",
                                "principalId": "[parameters('principalId')]",
                                "principalType": "ServicePrincipal"
                              }
                            }
                          ]
                        }
                      },
                      "dependsOn": [
                        "[extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', format('sentinel-diag-{0}', parameters('sources')[copyIndex()].key))]"
                      ]
                    }
                  ],
                  "outputs": {
                    "assignmentNames": {
                      "type": "array",
                      "copy": {
                        "count": "[length(parameters('sources'))]",
                        "input": "[format('sentinel-diag-{0}', parameters('sources')[copyIndex()].key)]"
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  ]
}