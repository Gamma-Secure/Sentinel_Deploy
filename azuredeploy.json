{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "18090301338456680091"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "metadata": {
        "description": "Region for the resource group and workspace"
      }
    },
    "resourceGroupName": {
      "type": "string"
    },
    "workspaceName": {
      "type": "string"
    },
    "retentionInDays": {
      "type": "int",
      "defaultValue": 90,
      "minValue": 30,
      "maxValue": 730
    },
    "dailyQuotaGb": {
      "type": "int",
      "defaultValue": -1,
      "metadata": {
        "description": "Daily ingestion cap in GB. -1 = no cap"
      }
    },
    "enableAzureActivity": {
      "type": "bool",
      "defaultValue": true
    },
    "enableDefenderForCloud": {
      "type": "bool",
      "defaultValue": false
    },
    "enableEntraIdProtection": {
      "type": "bool",
      "defaultValue": false
    },
    "enableDefenderXdr": {
      "type": "bool",
      "defaultValue": false
    },
    "enableEntraSignInLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "enableEntraAuditLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "enableEntraRiskLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "enableEntraGraphLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "enableKeyVaultLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "enableNsgLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "enableFirewallLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "enableAppGatewayLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "enableAksLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "enableAppServiceLogs": {
      "type": "bool",
      "defaultValue": false
    },
    "tags": {
      "type": "object",
      "defaultValue": {}
    }
  },
  "variables": {
    "activityCategories": [
      "Administrative",
      "Security",
      "ServiceHealth",
      "Alert",
      "Recommendation",
      "Policy",
      "Autoscale",
      "ResourceHealth"
    ],
    "entraSignIn": "[if(parameters('enableEntraSignInLogs'), createArray('SignInLogs', 'NonInteractiveUserSignInLogs', 'ServicePrincipalSignInLogs', 'ManagedIdentitySignInLogs'), createArray())]",
    "entraAudit": "[if(parameters('enableEntraAuditLogs'), createArray('AuditLogs', 'ProvisioningLogs'), createArray())]",
    "entraRisk": "[if(parameters('enableEntraRiskLogs'), createArray('RiskyUsers', 'UserRiskEvents', 'RiskyServicePrincipals', 'ServicePrincipalRiskEvents'), createArray())]",
    "entraGraph": "[if(parameters('enableEntraGraphLogs'), createArray('MicrosoftGraphActivityLogs'), createArray())]",
    "entraCategories": "[concat(variables('entraSignIn'), variables('entraAudit'), variables('entraRisk'), variables('entraGraph'))]",
    "allResourceSources": [
      {
        "enabled": "[parameters('enableKeyVaultLogs')]",
        "key": "keyvault",
        "label": "Key Vault",
        "resourceType": "Microsoft.KeyVault/vaults"
      },
      {
        "enabled": "[parameters('enableNsgLogs')]",
        "key": "nsg",
        "label": "Network Security Group",
        "resourceType": "Microsoft.Network/networkSecurityGroups"
      },
      {
        "enabled": "[parameters('enableFirewallLogs')]",
        "key": "firewall",
        "label": "Azure Firewall",
        "resourceType": "Microsoft.Network/azureFirewalls"
      },
      {
        "enabled": "[parameters('enableAppGatewayLogs')]",
        "key": "appgw",
        "label": "Application Gateway / WAF",
        "resourceType": "Microsoft.Network/applicationGateways"
      },
      {
        "enabled": "[parameters('enableAksLogs')]",
        "key": "aks",
        "label": "AKS",
        "resourceType": "Microsoft.ContainerService/managedClusters"
      },
      {
        "enabled": "[parameters('enableAppServiceLogs')]",
        "key": "appservice",
        "label": "App Service",
        "resourceType": "Microsoft.Web/sites"
      }
    ],
    "selectedResourceSources": "[filter(variables('allResourceSources'), lambda('s', lambdaVariables('s').enabled))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2024-03-01",
      "name": "[parameters('resourceGroupName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]"
    },
    {
      "condition": "[parameters('enableAzureActivity')]",
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "name": "sentinel-activity-logs",
      "properties": {
        "copy": [
          {
            "name": "logs",
            "count": "[length(variables('activityCategories'))]",
            "input": {
              "category": "[variables('activityCategories')[copyIndex('logs')]]",
              "enabled": true
            }
          }
        ],
        "workspaceId": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'sentinel-core'), '2025-04-01').outputs.workspaceId.value]"
      },
      "dependsOn": [
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'sentinel-core')]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "sentinel-core",
      "resourceGroup": "[parameters('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "workspaceName": {
            "value": "[parameters('workspaceName')]"
          },
          "retentionInDays": {
            "value": "[parameters('retentionInDays')]"
          },
          "dailyQuotaGb": {
            "value": "[parameters('dailyQuotaGb')]"
          },
          "tenantId": {
            "value": "[tenant().tenantId]"
          },
          "subscriptionId": {
            "value": "[subscription().subscriptionId]"
          },
          "enableDefenderForCloud": {
            "value": "[parameters('enableDefenderForCloud')]"
          },
          "enableEntraIdProtection": {
            "value": "[parameters('enableEntraIdProtection')]"
          },
          "enableDefenderXdr": {
            "value": "[parameters('enableDefenderXdr')]"
          },
          "tags": {
            "value": "[parameters('tags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.47.16.16243",
              "templateHash": "1851866975785575104"
            }
          },
          "parameters": {
            "location": {
              "type": "string"
            },
            "workspaceName": {
              "type": "string"
            },
            "retentionInDays": {
              "type": "int"
            },
            "dailyQuotaGb": {
              "type": "int"
            },
            "tenantId": {
              "type": "string"
            },
            "subscriptionId": {
              "type": "string"
            },
            "enableDefenderForCloud": {
              "type": "bool"
            },
            "enableEntraIdProtection": {
              "type": "bool"
            },
            "enableDefenderXdr": {
              "type": "bool"
            },
            "tags": {
              "type": "object"
            }
          },
          "resources": [
            {
              "type": "Microsoft.OperationalInsights/workspaces",
              "apiVersion": "2023-09-01",
              "name": "[parameters('workspaceName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "sku": {
                  "name": "PerGB2018"
                },
                "retentionInDays": "[parameters('retentionInDays')]",
                "workspaceCapping": "[if(greater(parameters('dailyQuotaGb'), 0), createObject('dailyQuotaGb', parameters('dailyQuotaGb')), null())]"
              }
            },
            {
              "type": "Microsoft.SecurityInsights/onboardingStates",
              "apiVersion": "2024-03-01",
              "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
              "name": "default",
              "properties": {},
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"
              ]
            },
            {
              "condition": "[parameters('enableDefenderForCloud')]",
              "type": "Microsoft.SecurityInsights/dataConnectors",
              "apiVersion": "2024-03-01",
              "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
              "name": "[guid(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName')), 'AzureSecurityCenter')]",
              "kind": "AzureSecurityCenter",
              "properties": {
                "subscriptionId": "[parameters('subscriptionId')]",
                "dataTypes": {
                  "alerts": {
                    "state": "Enabled"
                  }
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
                "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName')), 'Microsoft.SecurityInsights/onboardingStates', 'default')]"
              ]
            },
            {
              "condition": "[parameters('enableEntraIdProtection')]",
              "type": "Microsoft.SecurityInsights/dataConnectors",
              "apiVersion": "2024-03-01",
              "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
              "name": "[guid(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName')), 'AzureActiveDirectory')]",
              "kind": "AzureActiveDirectory",
              "properties": {
                "tenantId": "[parameters('tenantId')]",
                "dataTypes": {
                  "alerts": {
                    "state": "Enabled"
                  }
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
                "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName')), 'Microsoft.SecurityInsights/onboardingStates', 'default')]"
              ]
            },
            {
              "condition": "[parameters('enableDefenderXdr')]",
              "type": "Microsoft.SecurityInsights/dataConnectors",
              "apiVersion": "2024-03-01",
              "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
              "name": "[guid(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName')), 'MicrosoftThreatProtection')]",
              "kind": "MicrosoftThreatProtection",
              "properties": {
                "tenantId": "[parameters('tenantId')]",
                "dataTypes": {
                  "incidents": {
                    "state": "Enabled"
                  }
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
                "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName')), 'Microsoft.SecurityInsights/onboardingStates', 'default')]"
              ]
            }
          ],
          "outputs": {
            "workspaceId": {
              "type": "string",
              "value": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('resourceGroupName'))]"
      ]
    },
    {
      "condition": "[not(empty(variables('entraCategories')))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "sentinel-entra-diagnostics",
      "scope": "/",
      "location": "[deployment().location]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "workspaceId": {
            "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'sentinel-core'), '2025-04-01').outputs.workspaceId.value]"
          },
          "categories": {
            "value": "[variables('entraCategories')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-08-01/tenantDeploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.47.16.16243",
              "templateHash": "2145477407892355751"
            }
          },
          "parameters": {
            "workspaceId": {
              "type": "string"
            },
            "categories": {
              "type": "array",
              "defaultValue": [
                "SignInLogs",
                "AuditLogs",
                "NonInteractiveUserSignInLogs",
                "ServicePrincipalSignInLogs",
                "ManagedIdentitySignInLogs",
                "ProvisioningLogs"
              ]
            }
          },
          "resources": [
            {
              "type": "microsoft.aadiam/diagnosticSettings",
              "apiVersion": "2017-04-01",
              "name": "sentinel-entra-logs",
              "properties": {
                "copy": [
                  {
                    "name": "logs",
                    "count": "[length(parameters('categories'))]",
                    "input": {
                      "category": "[parameters('categories')[copyIndex('logs')]]",
                      "enabled": true
                    }
                  }
                ],
                "workspaceId": "[parameters('workspaceId')]"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'sentinel-core')]"
      ]
    },
    {
      "condition": "[not(empty(variables('selectedResourceSources')))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "sentinel-resource-diagnostics",
      "location": "[deployment().location]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "workspaceId": {
            "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'sentinel-core'), '2025-04-01').outputs.workspaceId.value]"
          },
          "sources": {
            "value": "[variables('selectedResourceSources')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.47.16.16243",
              "templateHash": "16939346574362201061"
            }
          },
          "parameters": {
            "location": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            },
            "sources": {
              "type": "array",
              "metadata": {
                "description": "Array of { key, label, resourceType }"
              }
            }
          },
          "variables": {
            "roleIds": [
              "749f88d5-cbae-40b8-bcfc-e573ddc772fa",
              "92aaf0da-9dab-42b6-94a3-d43ce8d16293"
            ],
            "settingName": "setByPolicy-Sentinel"
          },
          "resources": [
            {
              "copy": {
                "name": "defs",
                "count": "[length(parameters('sources'))]"
              },
              "type": "Microsoft.Authorization/policyDefinitions",
              "apiVersion": "2023-04-01",
              "name": "[format('sentinel-diag-{0}', parameters('sources')[copyIndex()].key)]",
              "properties": {
                "displayName": "[format('Sentinel: send {0} resource logs to Log Analytics', parameters('sources')[copyIndex()].label)]",
                "policyType": "Custom",
                "mode": "Indexed",
                "parameters": {
                  "logAnalytics": {
                    "type": "String",
                    "metadata": {
                      "displayName": "Log Analytics workspace resource ID"
                    }
                  }
                },
                "policyRule": {
                  "if": {
                    "field": "type",
                    "equals": "[parameters('sources')[copyIndex()].resourceType]"
                  },
                  "then": {
                    "effect": "deployIfNotExists",
                    "details": {
                      "copy": [
                        {
                          "name": "roleDefinitionIds",
                          "count": "[length(variables('roleIds'))]",
                          "input": "[format('/providers/Microsoft.Authorization/roleDefinitions/{0}', variables('roleIds')[copyIndex('roleDefinitionIds')])]"
                        }
                      ],
                      "type": "Microsoft.Insights/diagnosticSettings",
                      "name": "[variables('settingName')]",
                      "existenceCondition": {
                        "allOf": [
                          {
                            "field": "Microsoft.Insights/diagnosticSettings/workspaceId",
                            "equals": "[[parameters('logAnalytics')]"
                          }
                        ]
                      },
                      "deployment": {
                        "properties": {
                          "mode": "incremental",
                          "template": {
                            "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
                            "contentVersion": "1.0.0.0",
                            "parameters": {
                              "resourceName": {
                                "type": "string"
                              },
                              "location": {
                                "type": "string"
                              },
                              "logAnalytics": {
                                "type": "string"
                              }
                            },
                            "resources": [
                              {
                                "type": "[format('{0}/providers/diagnosticSettings', parameters('sources')[copyIndex()].resourceType)]",
                                "apiVersion": "2021-05-01-preview",
                                "name": "[format('[concat(parameters(''resourceName''), ''/Microsoft.Insights/{0}'')]', variables('settingName'))]",
                                "location": "[[parameters('location')]",
                                "properties": {
                                  "workspaceId": "[[parameters('logAnalytics')]",
                                  "logs": [
                                    {
                                      "categoryGroup": "allLogs",
                                      "enabled": true
                                    }
                                  ]
                                }
                              }
                            ]
                          },
                          "parameters": {
                            "resourceName": {
                              "value": "[[field('name')]"
                            },
                            "location": {
                              "value": "[[field('location')]"
                            },
                            "logAnalytics": {
                              "value": "[[parameters('logAnalytics')]"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "copy": {
                "name": "assigns",
                "count": "[length(parameters('sources'))]"
              },
              "type": "Microsoft.Authorization/policyAssignments",
              "apiVersion": "2024-04-01",
              "name": "[format('sentinel-diag-{0}', parameters('sources')[copyIndex()].key)]",
              "location": "[parameters('location')]",
              "identity": {
                "type": "SystemAssigned"
              },
              "properties": {
                "displayName": "[format('Sentinel: {0} logs to Log Analytics', parameters('sources')[copyIndex()].label)]",
                "policyDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/policyDefinitions', format('sentinel-diag-{0}', parameters('sources')[copyIndex()].key))]",
                "parameters": {
                  "logAnalytics": {
                    "value": "[parameters('workspaceId')]"
                  }
                }
              },
              "dependsOn": [
                "[subscriptionResourceId('Microsoft.Authorization/policyDefinitions', format('sentinel-diag-{0}', parameters('sources')[copyIndex()].key))]"
              ]
            },
            {
              "copy": {
                "name": "roles",
                "count": "[length(range(0, mul(length(parameters('sources')), 2)))]"
              },
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(subscription().id, parameters('sources')[div(range(0, mul(length(parameters('sources')), 2))[copyIndex()], 2)].key, variables('roleIds')[mod(range(0, mul(length(parameters('sources')), 2))[copyIndex()], 2)])]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roleIds')[mod(range(0, mul(length(parameters('sources')), 2))[copyIndex()], 2)])]",
                "principalId": "[reference(subscriptionResourceId('Microsoft.Authorization/policyAssignments', format('sentinel-diag-{0}', parameters('sources')[div(range(0, mul(length(parameters('sources')), 2))[copyIndex()], 2)].key)), '2024-04-01', 'full').identity.principalId]",
                "principalType": "ServicePrincipal"
              },
              "dependsOn": [
                "[subscriptionResourceId('Microsoft.Authorization/policyAssignments', format('sentinel-diag-{0}', parameters('sources')[div(range(0, mul(length(parameters('sources')), 2))[copyIndex()], 2)].key))]"
              ]
            }
          ],
          "outputs": {
            "assignmentNames": {
              "type": "array",
              "copy": {
                "count": "[length(parameters('sources'))]",
                "input": "[format('sentinel-diag-{0}', parameters('sources')[copyIndex()].key)]"
              }
            }
          }
        }
      },
      "dependsOn": [
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'sentinel-core')]"
      ]
    }
  ],
  "outputs": {
    "workspaceId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'sentinel-core'), '2025-04-01').outputs.workspaceId.value]"
    },
    "workspaceName": {
      "type": "string",
      "value": "[parameters('workspaceName')]"
    },
    "policyAssignmentNames": {
      "type": "array",
      "value": "[coalesce(tryGet(if(not(empty(variables('selectedResourceSources'))), reference(subscriptionResourceId('Microsoft.Resources/deployments', 'sentinel-resource-diagnostics'), '2025-04-01'), null()), 'outputs', 'assignmentNames', 'value'), createArray())]"
    }
  }
}
