{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "basics": [
      {
        "name": "intro",
        "type": "Microsoft.Common.InfoBox",
        "visible": true,
        "options": {
          "icon": "Info",
          "text": "Deploys a Log Analytics workspace, onboards Microsoft Sentinel and enables the data sources you pick. Needs Owner (or Contributor + User Access Admin) on the subscription."
        }
      }
    ],
    "steps": [
      {
        "name": "workspace",
        "label": "Workspace",
        "elements": [
          {
            "name": "resourceGroupName",
            "type": "Microsoft.Common.TextBox",
            "label": "Resource group name",
            "defaultValue": "rg-sentinel-prod",
            "constraints": {
              "required": true,
              "regex": "^[a-zA-Z0-9._()-]{1,90}$",
              "validationMessage": "1-90 chars: letters, numbers, . _ ( ) -"
            }
          },
          {
            "name": "workspaceName",
            "type": "Microsoft.Common.TextBox",
            "label": "Workspace name",
            "defaultValue": "law-sentinel-prod",
            "constraints": {
              "required": true,
              "regex": "^[a-zA-Z0-9][a-zA-Z0-9-]{2,61}[a-zA-Z0-9]$",
              "validationMessage": "4-63 chars: letters, numbers, hyphens"
            }
          },
          {
            "name": "retention",
            "type": "Microsoft.Common.DropDown",
            "label": "Retention (days)",
            "defaultValue": "90",
            "toolTip": "First 90 days are free with Sentinel; beyond that is billed.",
            "constraints": {
              "required": true,
              "allowedValues": [
                {
                  "label": "30",
                  "value": 30
                },
                {
                  "label": "90",
                  "value": 90
                },
                {
                  "label": "180",
                  "value": 180
                },
                {
                  "label": "365",
                  "value": 365
                },
                {
                  "label": "730",
                  "value": 730
                }
              ]
            }
          },
          {
            "name": "dailyCap",
            "type": "Microsoft.Common.DropDown",
            "label": "Daily ingestion cap (GB)",
            "defaultValue": "No cap",
            "toolTip": "A cap stops ingestion (and detection) when hit. Use with care outside of dev/demo.",
            "constraints": {
              "required": true,
              "allowedValues": [
                {
                  "label": "No cap",
                  "value": -1
                },
                {
                  "label": "1",
                  "value": 1
                },
                {
                  "label": "5",
                  "value": 5
                },
                {
                  "label": "10",
                  "value": 10
                },
                {
                  "label": "50",
                  "value": 50
                }
              ]
            }
          }
        ]
      },
      {
        "name": "sources",
        "label": "Data sources",
        "elements": [
          {
            "name": "enableAzureActivity",
            "type": "Microsoft.Common.CheckBox",
            "label": "Azure Activity (subscription activity log)",
            "defaultValue": true
          },
          {
            "name": "enableDefenderForCloud",
            "type": "Microsoft.Common.CheckBox",
            "label": "Microsoft Defender for Cloud (alerts)",
            "defaultValue": false
          },
          {
            "name": "enableEntraIdProtection",
            "type": "Microsoft.Common.CheckBox",
            "label": "Entra ID Protection (alerts)",
            "defaultValue": false
          },
          {
            "name": "enableDefenderXdr",
            "type": "Microsoft.Common.CheckBox",
            "label": "Microsoft Defender XDR (incidents)",
            "defaultValue": false
          }
        ]
      },
      {
        "name": "entra",
        "label": "Entra ID logs",
        "elements": [
          {
            "name": "entraNote",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Warning",
              "text": "Creates a tenant-level diagnostic setting. The person deploying needs Global Administrator or Security Administrator in Entra, and sign-in logs need Entra ID P1 or P2. If you lack this, untick everything on this page and enable it later."
            }
          },
          {
            "name": "enableEntraSignInLogs",
            "type": "Microsoft.Common.CheckBox",
            "label": "Sign-in logs (interactive, non-interactive, service principal, managed identity)",
            "defaultValue": true
          },
          {
            "name": "enableEntraAuditLogs",
            "type": "Microsoft.Common.CheckBox",
            "label": "Audit and provisioning logs",
            "defaultValue": true
          },
          {
            "name": "enableEntraRiskLogs",
            "type": "Microsoft.Common.CheckBox",
            "label": "Identity Protection risk logs (risky users, risk events)",
            "defaultValue": false,
            "toolTip": "Needs Entra ID P2."
          },
          {
            "name": "enableEntraGraphLogs",
            "type": "Microsoft.Common.CheckBox",
            "label": "Microsoft Graph activity logs",
            "defaultValue": false,
            "toolTip": "High volume. Enable deliberately."
          }
        ]
      },
      {
        "name": "resources",
        "label": "Azure resource logs",
        "elements": [
          {
            "name": "resNote",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "Each option deploys an Azure Policy (DeployIfNotExists) at subscription scope that adds a diagnostic setting to every matching resource, now and in future. Existing resources are only fixed after a policy remediation task is run. Logs land in AzureDiagnostics or resource-specific tables. All log categories are sent, which can be costly for NSGs and Firewalls."
            }
          },
          {
            "name": "enableKeyVaultLogs",
            "type": "Microsoft.Common.CheckBox",
            "label": "Key Vault",
            "defaultValue": false
          },
          {
            "name": "enableNsgLogs",
            "type": "Microsoft.Common.CheckBox",
            "label": "Network Security Groups",
            "defaultValue": false
          },
          {
            "name": "enableFirewallLogs",
            "type": "Microsoft.Common.CheckBox",
            "label": "Azure Firewall",
            "defaultValue": false
          },
          {
            "name": "enableAppGatewayLogs",
            "type": "Microsoft.Common.CheckBox",
            "label": "Application Gateway / WAF",
            "defaultValue": false
          },
          {
            "name": "enableAksLogs",
            "type": "Microsoft.Common.CheckBox",
            "label": "Azure Kubernetes Service (AKS)",
            "defaultValue": false
          },
          {
            "name": "enableAppServiceLogs",
            "type": "Microsoft.Common.CheckBox",
            "label": "App Service",
            "defaultValue": false
          }
        ]
      }
    ],
    "outputs": {
      "location": "[location()]",
      "resourceGroupName": "[steps('workspace').resourceGroupName]",
      "workspaceName": "[steps('workspace').workspaceName]",
      "retentionInDays": "[steps('workspace').retention]",
      "dailyQuotaGb": "[steps('workspace').dailyCap]",
      "enableAzureActivity": "[steps('sources').enableAzureActivity]",
      "enableDefenderForCloud": "[steps('sources').enableDefenderForCloud]",
      "enableEntraIdProtection": "[steps('sources').enableEntraIdProtection]",
      "enableDefenderXdr": "[steps('sources').enableDefenderXdr]",
      "enableEntraSignInLogs": "[steps('entra').enableEntraSignInLogs]",
      "enableEntraAuditLogs": "[steps('entra').enableEntraAuditLogs]",
      "enableEntraRiskLogs": "[steps('entra').enableEntraRiskLogs]",
      "enableEntraGraphLogs": "[steps('entra').enableEntraGraphLogs]",
      "enableKeyVaultLogs": "[steps('resources').enableKeyVaultLogs]",
      "enableNsgLogs": "[steps('resources').enableNsgLogs]",
      "enableFirewallLogs": "[steps('resources').enableFirewallLogs]",
      "enableAppGatewayLogs": "[steps('resources').enableAppGatewayLogs]",
      "enableAksLogs": "[steps('resources').enableAksLogs]",
      "enableAppServiceLogs": "[steps('resources').enableAppServiceLogs]"
    }
  }
}
