{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "basics": [
      {
        "name": "intro",
        "type": "Microsoft.Common.InfoBox",
        "visible": true,
        "options": {
          "icon": "Info",
          "text": "Deploys a Log Analytics workspace, onboards Microsoft Sentinel and enables the data sources you pick on the following tabs. Needs Owner (or Contributor + User Access Administrator) on the subscription."
        }
      }
    ],
    "steps": [
      {
        "name": "workspace",
        "label": "Workspace",
        "elements": [
          {
            "name": "resourceGroupName",
            "type": "Microsoft.Common.TextBox",
            "label": "Resource group name",
            "defaultValue": "rg-sentinel-prod",
            "constraints": {
              "required": true,
              "regex": "^[a-zA-Z0-9._()-]{1,90}$",
              "validationMessage": "1-90 chars: letters, numbers, . _ ( ) -"
            }
          },
          {
            "name": "workspaceName",
            "type": "Microsoft.Common.TextBox",
            "label": "Workspace name",
            "defaultValue": "law-sentinel-prod",
            "constraints": {
              "required": true,
              "regex": "^[a-zA-Z0-9][a-zA-Z0-9-]{2,61}[a-zA-Z0-9]$",
              "validationMessage": "4-63 chars: letters, numbers, hyphens"
            }
          },
          {
            "name": "retention",
            "type": "Microsoft.Common.DropDown",
            "label": "Retention (days)",
            "defaultValue": "90",
            "toolTip": "First 90 days are free with Sentinel; beyond that is billed.",
            "constraints": {
              "required": true,
              "allowedValues": [
                {
                  "label": "30",
                  "value": 30
                },
                {
                  "label": "90",
                  "value": 90
                },
                {
                  "label": "180",
                  "value": 180
                },
                {
                  "label": "365",
                  "value": 365
                },
                {
                  "label": "730",
                  "value": 730
                }
              ]
            }
          },
          {
            "name": "dailyCap",
            "type": "Microsoft.Common.DropDown",
            "label": "Daily ingestion cap (GB)",
            "defaultValue": "No cap",
            "toolTip": "A cap stops ingestion (and detection) when hit. Use with care outside of dev/demo.",
            "constraints": {
              "required": true,
              "allowedValues": [
                {
                  "label": "No cap",
                  "value": -1
                },
                {
                  "label": "1",
                  "value": 1
                },
                {
                  "label": "5",
                  "value": 5
                },
                {
                  "label": "10",
                  "value": 10
                },
                {
                  "label": "50",
                  "value": 50
                }
              ]
            }
          }
        ]
      },
      {
        "name": "defender",
        "label": "Microsoft Defender",
        "elements": [
          {
            "name": "dNote",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "Defender XDR already brings in incidents (and the alerts behind them) from Defender for Endpoint, Identity, Office 365 and Cloud Apps. If you tick XDR, you normally don't need the individual connectors below. If your workspace is onboarded to the unified Defender portal, check the connector state there after deployment."
            }
          },
          {
            "name": "enableDefenderXdr",
            "type": "Microsoft.Common.CheckBox",
            "label": "Microsoft Defender XDR (incidents)",
            "defaultValue": false,
            "toolTip": "Uses a preview Sentinel API version. Needs Global or Security Administrator."
          },
          {
            "name": "enableDefenderXdrAlerts",
            "type": "Microsoft.Common.CheckBox",
            "label": "Also sync XDR alerts (SecurityAlert table)",
            "defaultValue": false,
            "visible": "[steps('defender').enableDefenderXdr]",
            "toolTip": "Incidents are always synced when XDR is enabled. Tick to also sync the underlying alerts."
          },
          {
            "name": "xdrEventsNote",
            "type": "Microsoft.Common.InfoBox",
            "visible": "[steps('defender').enableDefenderXdr]",
            "options": {
              "icon": "Info",
              "text": "Raw event tables (DeviceFileEvents, DeviceProcessEvents, DeviceNetworkEvents, Email*, Identity*, CloudAppEvents and others) can't be enabled by a template. After deployment: Sentinel > Data connectors > Microsoft Defender XDR > Open connector page > Connect events > tick the tables > Apply Changes. Device tables are high volume, so start with the ones your detections need."
            }
          },
          {
            "name": "dWarn",
            "type": "Microsoft.Common.InfoBox",
            "visible": "[and(steps('defender').enableDefenderXdr, or(steps('defender').enableDefenderForCloudApps, steps('defender').enableDefenderForIdentity, steps('defender').enableDefenderForOffice365, steps('defender').enableDefenderForEndpoint))]",
            "options": {
              "icon": "Warning",
              "text": "XDR is ticked together with individual Defender connectors. This usually creates duplicate incidents."
            }
          },
          {
            "name": "enableDefenderForCloud",
            "type": "Microsoft.Common.CheckBox",
            "label": "Microsoft Defender for Cloud (alerts, this subscription)",
            "defaultValue": false,
            "toolTip": "Needs Security Reader on the subscription."
          },
          {
            "name": "enableDefenderForIdentity",
            "type": "Microsoft.Common.CheckBox",
            "label": "Microsoft Defender for Identity (alerts)",
            "defaultValue": false
          },
          {
            "name": "enableDefenderForCloudApps",
            "type": "Microsoft.Common.CheckBox",
            "label": "Microsoft Defender for Cloud Apps (alerts)",
            "defaultValue": false
          },
          {
            "name": "enableDefenderForCloudAppsDiscovery",
            "type": "Microsoft.Common.CheckBox",
            "label": "Include Cloud Apps Cloud Discovery logs",
            "defaultValue": false,
            "visible": "[steps('defender').enableDefenderForCloudApps]"
          },
          {
            "name": "enableDefenderForOffice365",
            "type": "Microsoft.Common.CheckBox",
            "label": "Microsoft Defender for Office 365 (alerts)",
            "defaultValue": false,
            "toolTip": "Uses a preview Sentinel API version."
          },
          {
            "name": "enableDefenderForEndpoint",
            "type": "Microsoft.Common.CheckBox",
            "label": "Microsoft Defender for Endpoint (alerts, legacy connector)",
            "defaultValue": false,
            "toolTip": "Superseded by Defender XDR."
          }
        ]
      },
      {
        "name": "entra",
        "label": "Entra ID",
        "elements": [
          {
            "name": "eNote",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "This enables the Entra ID Protection alerts connector. Entra sign-in and audit logs are a tenant-level setting that needs Owner at the tenant root, so they are deployed separately using the Tenant add-ons template (see the README), or by running enable-entra-logs.sh. Deploy this template first."
            }
          },
          {
            "name": "enableEntraIdProtection",
            "type": "Microsoft.Common.CheckBox",
            "label": "Entra ID Protection alerts (connector)",
            "defaultValue": false
          }
        ]
      },
      {
        "name": "azure",
        "label": "Azure",
        "elements": [
          {
            "name": "enableAzureActivity",
            "type": "Microsoft.Common.CheckBox",
            "label": "Azure Activity (this subscription's activity log)",
            "defaultValue": true
          },
          {
            "name": "activityNote",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "To collect Azure Activity from every subscription under a management group, use the Tenant add-ons template instead (needs Owner at the tenant root). Don't enable both for the same subscription, or the logs are ingested twice."
            }
          },
          {
            "name": "aNote",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "The options below deploy an Azure Policy (DeployIfNotExists) that adds a diagnostic setting to every matching resource, now and in future. They apply to the subscription selected on the Basics tab, plus any extra subscription IDs you list at the bottom of this tab. To cover a whole management group, use the Tenant add-ons template instead. All log categories are sent, which can be costly for NSGs and Firewalls. Needs Owner on each subscription covered."
            }
          },
          {
            "name": "enableKeyVaultLogs",
            "type": "Microsoft.Common.CheckBox",
            "label": "Key Vault",
            "defaultValue": false
          },
          {
            "name": "enableNsgLogs",
            "type": "Microsoft.Common.CheckBox",
            "label": "Network Security Groups",
            "defaultValue": false
          },
          {
            "name": "enableFirewallLogs",
            "type": "Microsoft.Common.CheckBox",
            "label": "Azure Firewall",
            "defaultValue": false
          },
          {
            "name": "enableAppGatewayLogs",
            "type": "Microsoft.Common.CheckBox",
            "label": "Application Gateway / WAF",
            "defaultValue": false
          },
          {
            "name": "enableAksLogs",
            "type": "Microsoft.Common.CheckBox",
            "label": "Azure Kubernetes Service (AKS)",
            "defaultValue": false
          },
          {
            "name": "enableAppServiceLogs",
            "type": "Microsoft.Common.CheckBox",
            "label": "App Service",
            "defaultValue": false
          },
          {
            "name": "remediateExistingResources",
            "type": "Microsoft.Common.CheckBox",
            "label": "Fix existing resources now (creates remediation tasks)",
            "defaultValue": true,
            "visible": "[or(steps('azure').enableKeyVaultLogs, steps('azure').enableNsgLogs, steps('azure').enableFirewallLogs, steps('azure').enableAppGatewayLogs, steps('azure').enableAksLogs, steps('azure').enableAppServiceLogs)]",
            "toolTip": "Without this, the policies only apply to newly created resources."
          },
          {
            "name": "additionalSubscriptionIds",
            "type": "Microsoft.Common.TextBox",
            "label": "Additional subscription IDs (optional)",
            "defaultValue": "",
            "visible": "[or(steps('azure').enableAzureActivity, or(steps('azure').enableKeyVaultLogs, steps('azure').enableNsgLogs, steps('azure').enableFirewallLogs, steps('azure').enableAppGatewayLogs, steps('azure').enableAksLogs, steps('azure').enableAppServiceLogs))]",
            "toolTip": "Comma-separated subscription GUIDs to cover as well. Do not include the subscription you are deploying into. You need Owner on each.",
            "constraints": {
              "required": false,
              "regex": "^$|^[0-9a-fA-F-]{36}(\\s*,\\s*[0-9a-fA-F-]{36})*$",
              "validationMessage": "Comma-separated subscription GUIDs, or leave empty"
            }
          }
        ]
      },
      {
        "name": "m365",
        "label": "Microsoft 365",
        "elements": [
          {
            "name": "mNote",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "Requires unified audit logging to be on in the tenant, and Global or Security Administrator to connect. Items marked preview use a preview Sentinel API version."
            }
          },
          {
            "name": "enableO365Exchange",
            "type": "Microsoft.Common.CheckBox",
            "label": "Exchange Online",
            "defaultValue": false
          },
          {
            "name": "enableO365SharePoint",
            "type": "Microsoft.Common.CheckBox",
            "label": "SharePoint and OneDrive",
            "defaultValue": false
          },
          {
            "name": "enableO365Teams",
            "type": "Microsoft.Common.CheckBox",
            "label": "Teams",
            "defaultValue": false
          },
          {
            "name": "enableInsiderRisk",
            "type": "Microsoft.Common.CheckBox",
            "label": "Insider Risk Management (preview API)",
            "defaultValue": false
          },
          {
            "name": "enablePowerBI",
            "type": "Microsoft.Common.CheckBox",
            "label": "Power BI (preview API)",
            "defaultValue": false
          },
          {
            "name": "enableDynamics365",
            "type": "Microsoft.Common.CheckBox",
            "label": "Dynamics 365 (preview API)",
            "defaultValue": false
          },
          {
            "name": "enableProject",
            "type": "Microsoft.Common.CheckBox",
            "label": "Microsoft Project (preview API)",
            "defaultValue": false
          },
          {
            "name": "enablePurviewInfoProtection",
            "type": "Microsoft.Common.CheckBox",
            "label": "Purview Information Protection (preview API)",
            "defaultValue": false
          }
        ]
      },
      {
        "name": "ti",
        "label": "Threat intelligence",
        "elements": [
          {
            "name": "enableMdti",
            "type": "Microsoft.Common.CheckBox",
            "label": "Microsoft Defender Threat Intelligence (free emerging threat feed)",
            "defaultValue": false,
            "toolTip": "Ingests all available history on first sync."
          },
          {
            "name": "enableTip",
            "type": "Microsoft.Common.CheckBox",
            "label": "Threat Intelligence Platforms (Graph tiIndicator, legacy)",
            "defaultValue": false
          }
        ]
      },
      {
        "name": "aws",
        "label": "AWS",
        "elements": [
          {
            "name": "awsNote",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Warning",
              "text": "The AWS side must already exist: an IAM role that trusts Sentinel (the trust policy values are shown on the connector page in Sentinel, and the workspace ID is exposed as a deployment output), plus CloudTrail and, for S3, the bucket and SQS queue. This wizard only creates the Sentinel connector."
            }
          },
          {
            "name": "enableAwsCloudTrail",
            "type": "Microsoft.Common.CheckBox",
            "label": "AWS CloudTrail",
            "defaultValue": false
          },
          {
            "name": "awsCloudTrailRoleArn",
            "type": "Microsoft.Common.TextBox",
            "label": "CloudTrail IAM role ARN",
            "defaultValue": "",
            "visible": "[steps('aws').enableAwsCloudTrail]",
            "constraints": {
              "required": true,
              "regex": "^arn:aws:iam::[0-9]{12}:role/.+$",
              "validationMessage": "Enter a valid IAM role ARN"
            }
          },
          {
            "name": "enableAwsS3",
            "type": "Microsoft.Common.CheckBox",
            "label": "AWS S3 (VPC Flow, GuardDuty, CloudTrail, S3 access logs; preview API)",
            "defaultValue": false
          },
          {
            "name": "awsS3RoleArn",
            "type": "Microsoft.Common.TextBox",
            "label": "S3 connector IAM role ARN",
            "defaultValue": "",
            "visible": "[steps('aws').enableAwsS3]",
            "constraints": {
              "required": true,
              "regex": "^arn:aws:iam::[0-9]{12}:role/.+$",
              "validationMessage": "Enter a valid IAM role ARN"
            }
          },
          {
            "name": "awsS3SqsUrl",
            "type": "Microsoft.Common.TextBox",
            "label": "SQS queue URL",
            "defaultValue": "",
            "visible": "[steps('aws').enableAwsS3]",
            "constraints": {
              "required": true,
              "regex": "^https://sqs\\.[a-z0-9-]+\\.amazonaws\\.com/[0-9]{12}/.+$",
              "validationMessage": "Enter a valid SQS queue URL"
            }
          },
          {
            "name": "awsS3Table",
            "type": "Microsoft.Common.DropDown",
            "label": "Destination table",
            "defaultValue": "AWSCloudTrail",
            "visible": "[steps('aws').enableAwsS3]",
            "constraints": {
              "required": true,
              "allowedValues": [
                {
                  "label": "AWSCloudTrail",
                  "value": "AWSCloudTrail"
                },
                {
                  "label": "AWSVPCFlow",
                  "value": "AWSVPCFlow"
                },
                {
                  "label": "AWSGuardDuty",
                  "value": "AWSGuardDuty"
                },
                {
                  "label": "AWSS3ServerAccess",
                  "value": "AWSS3ServerAccess"
                }
              ]
            }
          }
        ]
      }
    ],
    "outputs": {
      "location": "[location()]",
      "resourceGroupName": "[steps('workspace').resourceGroupName]",
      "workspaceName": "[steps('workspace').workspaceName]",
      "retentionInDays": "[steps('workspace').retention]",
      "dailyQuotaGb": "[steps('workspace').dailyCap]",
      "enableDefenderXdr": "[steps('defender').enableDefenderXdr]",
      "enableDefenderForCloud": "[steps('defender').enableDefenderForCloud]",
      "enableDefenderForIdentity": "[steps('defender').enableDefenderForIdentity]",
      "enableDefenderForCloudApps": "[steps('defender').enableDefenderForCloudApps]",
      "enableDefenderForCloudAppsDiscovery": "[and(steps('defender').enableDefenderForCloudApps, steps('defender').enableDefenderForCloudAppsDiscovery)]",
      "enableDefenderForOffice365": "[steps('defender').enableDefenderForOffice365]",
      "enableDefenderForEndpoint": "[steps('defender').enableDefenderForEndpoint]",
      "enableEntraIdProtection": "[steps('entra').enableEntraIdProtection]",
      "enableAzureActivity": "[steps('azure').enableAzureActivity]",
      "enableKeyVaultLogs": "[steps('azure').enableKeyVaultLogs]",
      "enableNsgLogs": "[steps('azure').enableNsgLogs]",
      "enableFirewallLogs": "[steps('azure').enableFirewallLogs]",
      "enableAppGatewayLogs": "[steps('azure').enableAppGatewayLogs]",
      "enableAksLogs": "[steps('azure').enableAksLogs]",
      "enableAppServiceLogs": "[steps('azure').enableAppServiceLogs]",
      "enableO365Exchange": "[steps('m365').enableO365Exchange]",
      "enableO365SharePoint": "[steps('m365').enableO365SharePoint]",
      "enableO365Teams": "[steps('m365').enableO365Teams]",
      "enableInsiderRisk": "[steps('m365').enableInsiderRisk]",
      "enablePowerBI": "[steps('m365').enablePowerBI]",
      "enableDynamics365": "[steps('m365').enableDynamics365]",
      "enableProject": "[steps('m365').enableProject]",
      "enablePurviewInfoProtection": "[steps('m365').enablePurviewInfoProtection]",
      "enableMdti": "[steps('ti').enableMdti]",
      "enableTip": "[steps('ti').enableTip]",
      "enableAwsCloudTrail": "[steps('aws').enableAwsCloudTrail]",
      "awsCloudTrailRoleArn": "[if(steps('aws').enableAwsCloudTrail, steps('aws').awsCloudTrailRoleArn, '')]",
      "enableAwsS3": "[steps('aws').enableAwsS3]",
      "awsS3RoleArn": "[if(steps('aws').enableAwsS3, steps('aws').awsS3RoleArn, '')]",
      "awsS3SqsUrl": "[if(steps('aws').enableAwsS3, steps('aws').awsS3SqsUrl, '')]",
      "awsS3Table": "[if(steps('aws').enableAwsS3, steps('aws').awsS3Table, 'AWSCloudTrail')]",
      "enableDefenderXdrAlerts": "[and(steps('defender').enableDefenderXdr, steps('defender').enableDefenderXdrAlerts)]",
      "remediateExistingResources": "[if(or(steps('azure').enableKeyVaultLogs, steps('azure').enableNsgLogs, steps('azure').enableFirewallLogs, steps('azure').enableAppGatewayLogs, steps('azure').enableAksLogs, steps('azure').enableAppServiceLogs), steps('azure').remediateExistingResources, false)]",
      "additionalSubscriptionIds": "[if(or(steps('azure').enableAzureActivity, or(steps('azure').enableKeyVaultLogs, steps('azure').enableNsgLogs, steps('azure').enableFirewallLogs, steps('azure').enableAppGatewayLogs, steps('azure').enableAksLogs, steps('azure').enableAppServiceLogs)), steps('azure').additionalSubscriptionIds, '')]"
    }
  }
}